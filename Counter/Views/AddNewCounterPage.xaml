<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.AddNewCounterPage"
             xmlns:viewModel="clr-namespace:Counter.ViewModels"
             x:DataType="viewModel:AddNewCounterViewModel"
             Title="Add New Counter">

    <VerticalStackLayout Padding="20" Spacing="15" HorizontalOptions="Center" MaximumWidthRequest="600">
        <Label Text="{Binding AddNewCounterText}"
               FontSize="36"
               FontAttributes="Bold" />
        
        <Label Text="{Binding CounterNameText}"/>

        <Entry Placeholder="{Binding NameEntryPlaceholder}"
               x:Name="CounterNameEntry"
               MaxLength="50"
               Text="{Binding CounterName}"/>
        
        <Label Text="{Binding InitialValueText}"/>

        <Entry Placeholder="{Binding InitialValueEntryPlaceholder}"
               x:Name="InitialValueEntry"
               Keyboard="Numeric"
               Text="{Binding CounterInitialValue}"/>

        <Picker Title="{Binding CounterColorText}"
            ItemsSource="{Binding ColorsList}"
            ItemDisplayBinding="{Binding ColorName}"
            SelectedItem="{Binding SelectedColor}"/>

        <Button Text="{Binding AddNewCounterButtonText}"
                Command="{Binding AddNewCounterCommand}"/>
    </VerticalStackLayout>
</ContentPage>