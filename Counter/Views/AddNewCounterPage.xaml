<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.AddNewCounterPage"
             xmlns:viewModel="clr-namespace:Counter.ViewModels"
             x:DataType="viewModel:AddNewCounterViewModel"
             Title="AddNewCounterPage">
    <VerticalStackLayout Padding="20" Spacing="15" MaximumWidthRequest="400">
        <Label Text="Dodaj nowy licznik"
               FontSize="24"
               FontAttributes="Bold" />
        
        <Label Text="Nazwa licznika"
               FontSize="16"
               FontAttributes="Bold" />

        <Entry Placeholder="(np. licznik)"
               x:Name="CounterNameEntry"
               MaxLength="50" 
               Text="{Binding CounterName}"/>
        
        <Label Text="Wartość początkowa"
               FontSize="16"
               FontAttributes="Bold" />
        
        <Entry Placeholder="(np. 0)"
               x:Name="InitialValueEntry"
               Keyboard="Numeric"
               Text="{Binding CounterInitialValue}"/>

        <Button Text="Dodaj licznik"
                BackgroundColor="#FFD100"
                TextColor="Black"
                CornerRadius="10"
                Command="{Binding AddNewCounterCommand}"/>
    </VerticalStackLayout>
</ContentPage>