<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Counter.ViewModels"
             x:Class="Counter.Views.CountersPage"
             x:DataType="viewModels:CountersViewModel"
             Title="All Counters">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="{Binding AddCounterText}"
            IconImageSource="{FontImageSource Glyph='+', Color='Black', Size='22'}"
            Command="{Binding AddNewCounterCommand}"
            />
    </ContentPage.ToolbarItems>

        <VerticalStackLayout MaximumWidthRequest="600" Margin="0,20,0,0">
            <Grid RowDefinitions="Auto,*" >
                <Grid Grid.Row="0" ColumnDefinitions="*,*,100" ColumnSpacing="10">

                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label Text="{Binding CounterNameLabel}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                        <Label Text="{Binding CountLabel}" HorizontalTextAlignment="End"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End">
                        <Label Text="{Binding DangerZoneText}" HorizontalTextAlignment="End"/>
                </VerticalStackLayout>
                </Grid>

                <CollectionView
                    Grid.Row="1"
                    x:Name="CountersCollection"
                    ItemsSource="{Binding Counters}"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedCounter}"
                    SelectionChangedCommand="{Binding CounterSelectionCommand}">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Margin="0,20,0,0">
                            <Label Text="{Binding NoCountersText}"
                                Margin="0,20,0,0"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="{StaticResource Danger}"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:CounterViewModel">
                            <Border Stroke="{Binding CounterColor}" Background="{StaticResource Surface}"
                                Padding="20" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="*, *, 100" ColumnSpacing="10">

                                    <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding CounterName}" FontSize="24"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Counter}" TextColor="{Binding CounterColor}"  FontSize="24" HorizontalTextAlignment="End" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center" HorizontalOptions="End">
                                        <Button Text="{Binding DeleteText}" Command="{Binding DeleteCounterCommand}"
                                            BackgroundColor="{StaticResource Danger}"
                                            TextColor="White"/>
                                    </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </VerticalStackLayout>
</ContentPage>