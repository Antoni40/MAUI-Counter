<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.CounterPage"
             xmlns:viewModels="clr-namespace:Counter.ViewModels"
             x:DataType="viewModels:CounterViewModel"
             Title="Counter">

    <VerticalStackLayout Spacing="10" Margin="0,20,0,0" MaximumWidthRequest="600">
        <Label Text="{Binding Counter}" TextColor="{Binding CounterColor}" FontSize="48" HorizontalOptions="Center"/>
        <Label Text="{Binding CounterName}" FontSize="32" HorizontalOptions="Center"/>

        <Grid RowDefinitions="Auto,Auto" HorizontalOptions="Center" RowSpacing="10">
            <HorizontalStackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center">
                <Button Text="+" BackgroundColor="{Binding CounterColor}"
                    Command="{Binding IncrementCounterCommand}"
                    TextColor="Black"/>
                <Button Text="Reset" Command="{Binding ResetCounterCommand}"
                    BackgroundColor="{StaticResource TextSecondary}"/>
                <Button Text="-" BackgroundColor="{Binding CounterColor}"
                    Command="{Binding DecrementCounterCommand}"
                    TextColor="Black"/>
            </HorizontalStackLayout>

            <Button Grid.Row="1" Text="{Binding DeleteText}" Command="{Binding DeleteCounterCommand}" 
                BackgroundColor="{StaticResource Danger}" TextColor="White"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>